// Source: 04-signal-extension.ipynb; Nyquist folding across fs/2.
digraph nyquist_aliasing {
  graph [
    bgcolor="white", fontname="Arial", fontsize=18, fontcolor="#14263C",
    label="Nyquist folding (fs = 512 Hz)",
    labelloc=t, rankdir=LR, newrank=true, nodesep=0.30, ranksep=0.44, pad=0.14
  ];
  node [
    shape=box, style="rounded,filled", fontname="Arial", fontsize=15,
    fontcolor="#14263C", color="#BAC7D5", penwidth=1.5, margin="0.14,0.09"
  ];
  edge [
    fontname="Arial", fontsize=13.5, fontcolor="#14263C",
    color="#526780", penwidth=1.6, arrowsize=0.82
  ];

  subgraph cluster_resolved {
    label="Resolved [0, 256 Hz]";
    fontsize=16.5; style="rounded"; color="#BAC7D5"; margin=12;

    f40 [fillcolor="#E9F7F2", label=<
      <B>40 Hz</B><BR/>
      <FONT POINT-SIZE="12.5" COLOR="#2E7D6B">resolved</FONT>
    >];

    f212 [fillcolor="#FFF2D6", label=<
      <B>212 Hz alias</B><BR/>
      <FONT POINT-SIZE="12.5" COLOR="#526780">512 − 300 Hz</FONT>
    >];
    { rank=same; f40; f212; }
  }

  mirror [shape=octagon, style="filled", fillcolor="#F0EBFA", label=<
    <B>Nyquist</B><BR/>
    <B>256 Hz</B>
  >];

  subgraph cluster_above {
    label="Above Nyquist";
    fontsize=16.5; style="rounded,dashed"; color="#BAC7D5"; margin=12;

    f300 [fillcolor="#FBEDED", label=<
      <B>300 Hz</B><BR/>
      <FONT POINT-SIZE="12.5" COLOR="#7A2E2E">256 + 44 Hz</FONT>
    >];
  }

  f212 -> mirror [dir=back, color="#8B6D37", fontcolor="#8B6D37", penwidth=1.8, label=" −44 Hz "];
  mirror -> f300 [dir=back, color="#8B6D37", fontcolor="#8B6D37", penwidth=1.8, label=" folds "];
}
