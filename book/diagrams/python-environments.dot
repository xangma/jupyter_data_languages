// Source: 01-catalogue.ipynb; Python environment solvers and aligned kernel/shell execution.
digraph python_environments {
  graph [
    bgcolor="white", fontname="Arial", fontsize=19, fontcolor="#14263C",
    label="Lock one project environment and point both kernel and shell at it",
    labelloc=t, rankdir=TB, newrank=true, nodesep=0.18, ranksep=0.38, pad=0.14
  ];
  node [
    shape=plain, fontname="Arial", fontsize=15, fontcolor="#14263C",
    color="#BAC7D5", penwidth=1.4
  ];
  edge [
    fontname="Arial", fontsize=14, fontcolor="#14263C",
    color="#526780", penwidth=1.5, arrowsize=0.8
  ];

  subgraph cluster_tools {
    label="Dependency solvers & environment tools (pick one per project)";
    fontsize=16; style="rounded"; color="#BAC7D5"; margin=12;

    uv_tool [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#BAC7D5">
        <TR><TD BGCOLOR="#EAF3FE"><B>uv · used here</B></TD></TR>
        <TR><TD BGCOLOR="#F3F5F7">Solves &amp; locks PyPI graph<BR/><FONT FACE="Courier New" POINT-SIZE="12.5">uv sync --frozen --extra teaching&#160;</FONT></TD></TR>
      </TABLE>
    >];

    venv_tool [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#BAC7D5">
        <TR><TD BGCOLOR="#EAF3FE"><B>pip + venv · stdlib</B></TD></TR>
        <TR><TD BGCOLOR="#F3F5F7">Resolves against current env<BR/><FONT FACE="Courier New" POINT-SIZE="12.5">python -m pip install ...&#160;</FONT></TD></TR>
      </TABLE>
    >];

    conda_tool [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#BAC7D5">
        <TR><TD BGCOLOR="#EAF3FE"><B>conda / mamba · binary</B></TD></TR>
        <TR><TD BGCOLOR="#F3F5F7">Solves Python + C/CUDA<BR/><FONT FACE="Courier New" POINT-SIZE="12.5">CFITSIO · FFTW · MPI&#160;</FONT></TD></TR>
      </TABLE>
    >];

    { rank=same; uv_tool; venv_tool; conda_tool; }
  }

  project_env [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#BAC7D5">
      <TR><TD BGCOLOR="#F0EBFA"><B>Isolated project environment</B></TD></TR>
      <TR><TD BGCOLOR="#FFFFFF"><FONT FACE="Courier New" POINT-SIZE="13">&#160;.venv (uv / venv) or conda env&#160;&#160;</FONT><BR/><FONT FACE="Courier New" POINT-SIZE="13">&#160;/opt/course/.venv on CPD&#160;&#160;</FONT></TD></TR>
    </TABLE>
  >];

  unactivated_cmd [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#D8A8A8">
      <TR><TD BGCOLOR="#FFF2D6"><B>Unactivated shell (#1 trap)</B></TD></TR>
      <TR><TD BGCOLOR="#FFFFFF"><FONT FACE="Courier New" POINT-SIZE="13">&#160;pip install ... | pytest&#160;&#160;</FONT><BR/>Bare command in fresh shell</TD></TR>
    </TABLE>
  >];

  { rank=same; project_env; unactivated_cmd; }

  kernel_ok [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#BAC7D5">
      <TR><TD BGCOLOR="#E9F7F2"><B>Aligned · Jupyter kernel</B></TD></TR>
      <TR><TD BGCOLOR="#FFFFFF"><B>Python PhD (locked)</B><BR/><FONT FACE="Courier New" POINT-SIZE="12.5">sys.executable → project env&#160;</FONT></TD></TR>
    </TABLE>
  >];

  term_ok [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#BAC7D5">
      <TR><TD BGCOLOR="#E9F7F2"><B>Aligned · Activated shell</B></TD></TR>
      <TR><TD BGCOLOR="#FFFFFF"><FONT FACE="Courier New" POINT-SIZE="12.5">source .../activate | uv run&#160;</FONT><BR/><FONT FACE="Courier New" POINT-SIZE="12.5">python -m pytest · uv sync / pip&#160;</FONT></TD></TR>
    </TABLE>
  >];

  trap_bad [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#D8A8A8">
      <TR><TD BGCOLOR="#FBEDED"><B>Wrong interpreter!</B></TD></TR>
      <TR><TD BGCOLOR="#FBEDED"><FONT FACE="Courier New" POINT-SIZE="12.5">/usr/bin/python3 | conda (base)&#160;</FONT><BR/><FONT FACE="Courier New" POINT-SIZE="12.5">ModuleNotFoundError&#160;</FONT></TD></TR>
    </TABLE>
  >];

  { rank=same; kernel_ok; term_ok; trap_bad; }

  uv_tool -> project_env [label=" builds"];
  venv_tool -> project_env [label=" builds"];
  conda_tool -> project_env [label=" builds"];
  conda_tool -> unactivated_cmd [style=invis];

  project_env -> kernel_ok [color="#2F6F5E", label=" ipykernel"];
  project_env -> term_ok [color="#2F6F5E", label=" activate / uv run"];
  unactivated_cmd -> trap_bad [color="#A63A3A", style=dashed, penwidth=1.8, label=" bypasses env"];
}
