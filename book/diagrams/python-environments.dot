// Source: 00-primer.ipynb; Python environments, kernels and shells.
digraph python_environments {
  graph [
    bgcolor="white", fontname="Arial", fontsize=18, fontcolor="#14263C",
    label="One project environment for both kernel and shell",
    labelloc=t, rankdir=TB, newrank=true, nodesep=0.28, ranksep=0.44, pad=0.14,
    splines=true
  ];
  node [
    shape=box, style="rounded,filled", fontname="Arial", fontsize=15,
    fontcolor="#14263C", color="#BAC7D5", penwidth=1.5, margin="0.14,0.09"
  ];
  edge [
    fontname="Arial", fontsize=13.5, fontcolor="#14263C",
    color="#526780", penwidth=1.6, arrowsize=0.8
  ];

  subgraph cluster_tools {
    label="Pick one solver per project";
    fontsize=16; style="rounded"; color="#BAC7D5"; margin=12;

    uv_tool [fillcolor="#EAF3FE", label=<
      <B>uv</B><BR/>
      <FONT POINT-SIZE="12.5" COLOR="#526780">uv.lock</FONT>
    >];
    venv_tool [fillcolor="#EAF3FE", label=<
      <B>pip + venv</B><BR/>
      <FONT POINT-SIZE="12.5" COLOR="#526780">stdlib</FONT>
    >];
    conda_tool [fillcolor="#EAF3FE", label=<
      <B>conda / mamba</B><BR/>
      <FONT POINT-SIZE="12.5" COLOR="#526780">Python + C/GPU</FONT>
    >];
    { rank=same; uv_tool; venv_tool; conda_tool; }
  }

  project_env [fillcolor="#F0EBFA", label=<
    <B>Project environment</B><BR/>
    <FONT FACE="Courier New" POINT-SIZE="12.5" COLOR="#526780">.venv/bin/python</FONT>
  >];

  unactivated_cmd [fillcolor="#FFF2D6", color="#D8A8A8", label=<
    <B>Unactivated shell</B><BR/>
    <FONT POINT-SIZE="12.5" COLOR="#7A2E2E">bare pip / pytest</FONT>
  >];

  { rank=same; project_env; unactivated_cmd; }

  kernel_ok [fillcolor="#E9F7F2", label=<
    <B>Jupyter kernel</B><BR/>
    <FONT POINT-SIZE="12.5" COLOR="#2E7D6B">Python PhD (locked)</FONT>
  >];

  term_ok [fillcolor="#E9F7F2", label=<
    <B>Activated shell</B><BR/>
    <FONT POINT-SIZE="12.5" COLOR="#2E7D6B">activate / uv run</FONT>
  >];

  trap_bad [fillcolor="#FBEDED", color="#D8A8A8", label=<
    <B>Wrong Python!</B><BR/>
    <FONT FACE="Courier New" POINT-SIZE="12" COLOR="#7A2E2E">ModuleNotFoundError</FONT>
  >];

  { rank=same; kernel_ok; term_ok; trap_bad; }

  uv_tool -> project_env;
  venv_tool -> project_env;
  conda_tool -> project_env;
  conda_tool -> unactivated_cmd [style=invis];

  project_env -> kernel_ok [color="#2F6F5E", label=" ipykernel"];
  project_env -> term_ok [color="#2F6F5E", label=" activate"];
  unactivated_cmd -> trap_bad [color="#A63A3A", style=dashed, label=" bypasses .venv"];
}
