// Source: 01-catalogue.ipynb; one shared row mask vs separate per-column masks.
digraph shared_mask {
  graph [rankdir=TB, bgcolor="white", pad=0.14, nodesep=0.28, ranksep=0.34,
         fontname="Arial", fontsize=18, fontcolor="#14263C",
         label="One shared mask preserves row alignment", labelloc=t, newrank=true];
  node [shape=plain, fontname="Arial", fontsize=14.5, fontcolor="#14263C"];
  edge [fontname="Arial", fontsize=13.5, color="#14263C", fontcolor="#14263C",
        arrowsize=0.8, penwidth=1.5];

  aligned [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#BAC7D5">
      <TR><TD><B>row</B></TD><TD><B>dist</B></TD><TD><B>vel</B></TD><TD><B>sigma</B></TD><TD><B>valid</B></TD></TR>
      <TR><TD BGCOLOR="#E9F7F2">0</TD><TD>10</TD><TD>700</TD><TD>20</TD><TD BGCOLOR="#E9F7F2"><B>T</B></TD></TR>
      <TR><TD BGCOLOR="#FBEDED">1</TD><TD>20</TD><TD BGCOLOR="#FBEDED"><B>NaN</B></TD><TD>30</TD><TD BGCOLOR="#FBEDED"><B>F</B></TD></TR>
      <TR><TD BGCOLOR="#FBEDED">2</TD><TD>30</TD><TD>2100</TD><TD BGCOLOR="#FBEDED"><B>0</B></TD><TD BGCOLOR="#FBEDED"><B>F</B></TD></TR>
      <TR><TD BGCOLOR="#E9F7F2">3</TD><TD>40</TD><TD>2800</TD><TD>40</TD><TD BGCOLOR="#E9F7F2"><B>T</B></TD></TR>
    </TABLE>
  >];

  mask [shape=box, style="rounded,filled", fillcolor="#EAF3FE", color="#BAC7D5",
        margin="0.14,0.08", label="Shared mask\nvalid = [T, F, F, T]"];

  retained [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#BAC7D5">
      <TR><TD COLSPAN="4" BGCOLOR="#E9F7F2"><B>Aligned · shape (2,)</B></TD></TR>
      <TR><TD><B>row</B></TD><TD><B>dist</B></TD><TD><B>vel</B></TD><TD><B>sigma</B></TD></TR>
      <TR><TD>0</TD><TD>10</TD><TD>700</TD><TD>20</TD></TR>
      <TR><TD>3</TD><TD>40</TD><TD>2800</TD><TD>40</TD></TR>
    </TABLE>
  >];

  trap_masks [shape=box, style="rounded,filled", fillcolor="#FFF2D6", color="#BAC7D5",
              margin="0.14,0.08", label="Separate masks\nvel: [0,2,3] · sigma: [0,1,3]"];

  trap_result [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#BAC7D5">
      <TR><TD COLSPAN="3" BGCOLOR="#FBEDED"><B>Misaligned · shape (3,)</B></TD></TR>
      <TR><TD><B>idx</B></TD><TD><B>vel</B></TD><TD><B>sigma</B></TD></TR>
      <TR><TD>0</TD><TD>700 (r0)</TD><TD>20 (r0)</TD></TR>
      <TR><TD BGCOLOR="#FBEDED"><B>1</B></TD><TD BGCOLOR="#FFF2D6"><B>2100 (r2)</B></TD><TD BGCOLOR="#FBEDED"><B>30 (r1!)</B></TD></TR>
      <TR><TD>2</TD><TD>2800 (r3)</TD><TD>40 (r3)</TD></TR>
    </TABLE>
  >];

  { rank=same; mask; trap_masks; }
  { rank=same; retained; trap_result; }

  aligned -> mask [color="#2F6F5E", fontcolor="#2F6F5E", label=" correct"];
  mask -> retained [color="#2F6F5E"];

  aligned -> trap_masks [color="#A63A3A", fontcolor="#A63A3A", style=dashed, label=" bug"];
  trap_masks -> trap_result [color="#A63A3A", style=dashed];
}
