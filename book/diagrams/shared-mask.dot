// Schematic values; the full catalogue validity mask also checks magnitude.
digraph shared_mask {
  graph [rankdir=TB, bgcolor="white", pad=0.18, nodesep=0.25, ranksep=0.32,
         fontname="Arial", fontsize=18, color="#BAC7D5"];
  node [shape=plain, fontname="Arial", fontsize=18, fontcolor="#14263C"];
  edge [fontname="Arial", fontsize=18, color="#14263C", fontcolor="#14263C",
        arrowsize=0.8, penwidth=1.5];

  aligned [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#BAC7D5">
      <TR><TD COLSPAN="5" BGCOLOR="#F3F5F7"><B>Aligned columns — illustrative values</B></TD></TR>
      <TR><TD><B>row</B></TD><TD><B>distance</B><BR/>(Mpc)</TD><TD><B>velocity</B><BR/>(km/s)</TD><TD><B>velocity error</B><BR/>(km/s)</TD><TD><B>valid</B></TD></TR>
      <TR><TD BGCOLOR="#E9F7F2">0</TD><TD>10</TD><TD>700</TD><TD>20</TD><TD BGCOLOR="#E9F7F2"><B>T</B></TD></TR>
      <TR><TD BGCOLOR="#FBEDED">1</TD><TD>20</TD><TD BGCOLOR="#FBEDED"><B>NaN</B></TD><TD>30</TD><TD BGCOLOR="#FBEDED"><B>F</B></TD></TR>
      <TR><TD BGCOLOR="#FBEDED">2</TD><TD>30</TD><TD>2100</TD><TD BGCOLOR="#FBEDED"><B>0</B></TD><TD BGCOLOR="#FBEDED"><B>F</B></TD></TR>
      <TR><TD BGCOLOR="#E9F7F2">3</TD><TD>40</TD><TD>2800</TD><TD>40</TD><TD BGCOLOR="#E9F7F2"><B>T</B></TD></TR>
    </TABLE>
  >];

  mask [shape=box, style="rounded,filled", fillcolor="#EAF3FE", color="#BAC7D5",
        margin="0.20,0.12", label="One shared mask\nvalid = [T, F, F, T]"];

  retained [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#BAC7D5">
      <TR><TD COLSPAN="4" BGCOLOR="#E9F7F2"><B>Rows 0 and 3 remain in every column</B></TD></TR>
      <TR><TD><B>row</B></TD><TD><B>distance</B><BR/>(Mpc)</TD><TD><B>velocity</B><BR/>(km/s)</TD><TD><B>velocity error</B><BR/>(km/s)</TD></TR>
      <TR><TD>0</TD><TD>10</TD><TD>700</TD><TD>20</TD></TR>
      <TR><TD>3</TD><TD>40</TD><TD>2800</TD><TD>40</TD></TR>
    </TABLE>
  >];

  aligned -> mask;
  mask -> retained [label="apply to all three columns"];
}
