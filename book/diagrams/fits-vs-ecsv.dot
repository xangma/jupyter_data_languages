// Source: 01-catalogue.ipynb; ECSV vs FITS structure.
digraph fits_vs_ecsv {
  graph [
    bgcolor="white", fontname="Arial", fontsize=18, fontcolor="#14263C",
    label="Text ECSV vs binary FITS",
    labelloc=t, rankdir=TB, newrank=true, nodesep=0.26, ranksep=0.34, pad=0.12
  ];
  node [
    shape=plain, fontname="Arial", fontsize=14.5, fontcolor="#14263C",
    color="#BAC7D5", penwidth=1.4
  ];
  edge [
    fontname="Arial", fontsize=13, fontcolor="#14263C",
    color="#526780", penwidth=1.5, arrowsize=0.8
  ];

  subgraph cluster_ecsv {
    label="ECSV (.ecsv text)";
    fontsize=16.5; style="rounded"; color="#BAC7D5"; margin=10;

    ecsv_hdr [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#BAC7D5">
        <TR><TD BGCOLOR="#EAF3FE"><B>YAML Header</B></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#F3F5F7"><FONT FACE="Courier New" POINT-SIZE="12"># %ECSV 1.0<BR ALIGN="LEFT"/># - {name: distance, unit: Mpc}&#160;<BR ALIGN="LEFT"/># meta: {seed: 20261109}&#160;<BR ALIGN="LEFT"/></FONT></TD></TR>
      </TABLE>
    >];

    ecsv_body [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#BAC7D5">
        <TR><TD BGCOLOR="#E9F7F2"><B>Text rows</B></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Courier New" POINT-SIZE="12">distance velocity&#160;<BR ALIGN="LEFT"/>14.2 980.5<BR ALIGN="LEFT"/>41.8 2810.0<BR ALIGN="LEFT"/></FONT></TD></TR>
      </TABLE>
    >];

    ecsv_hdr -> ecsv_body;
  }

  subgraph cluster_fits {
    label="FITS (.fits binary)";
    fontsize=16.5; style="rounded"; color="#BAC7D5"; margin=10;

    fits_hdu0 [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#BAC7D5">
        <TR><TD BGCOLOR="#F0EBFA"><B>HDU 0 · Primary</B></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#F3F5F7"><FONT FACE="Courier New" POINT-SIZE="12">SIMPLE = T · EXTEND = T&#160;</FONT></TD></TR>
      </TABLE>
    >];

    fits_hdu1 [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#BAC7D5">
        <TR><TD BGCOLOR="#F0EBFA"><B>HDU 1 · Binary Table (≤8-char keys)</B></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#EAF3FE"><FONT FACE="Courier New" POINT-SIZE="12">TTYPE1='distance' TUNIT1='Mpc'&#160;<BR ALIGN="LEFT"/>SEED = 20261109   SYNTH = T&#160;<BR ALIGN="LEFT"/></FONT></TD></TR>
      </TABLE>
    >];

    fits_hdu0 -> fits_hdu1;
  }

  { rank=same; ecsv_hdr; fits_hdu0; }
  { rank=same; ecsv_body; fits_hdu1; }
}
