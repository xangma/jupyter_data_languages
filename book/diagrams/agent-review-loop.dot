// SPDX-License-Identifier: MIT
digraph agent_review_loop {
  graph [bgcolor="white", fontname="Arial", fontsize=20, fontcolor="#14263C",
         rankdir=TB, newrank=true, nodesep=0.36, ranksep=0.42, pad=0.16];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=17,
        fontcolor="#14263C", color="#BAC7D5", penwidth=1.5,
        margin="0.15,0.11"];
  edge [fontname="Arial", fontsize=15, fontcolor="#14263C", color="#526780",
        penwidth=1.6, arrowsize=0.8];

  // Boustrophedon (2-column, 4-rank) flow keeps width compact and text large.
  question [label="1 · YOU\nTask + independently\njustified expectations", fillcolor="#EAF3FE"];
  plan [label="2 · AGENT\nInspect files;\npropose a plan", fillcolor="#FFF2D6"];

  scope [label="3 · YOU\nReview plan &\nderive test cases", fillcolor="#EAF3FE"];
  draft_tests [label="4 · AGENT\nDraft\ntest_student_checks.py", fillcolor="#FFF2D6"];

  checkpoint [label="5 · YOU\nVerify failing run &\ncommit tests checkpoint", fillcolor="#F0EBFA"];
  repair [label="6 · AGENT\nEdit weighted_mean.py;\nrun fixed tests", fillcolor="#FFF2D6"];

  review [label="7 · YOU\nRerun independently;\ninspect entire diff", fillcolor="#EAF3FE"];
  accept [label="8 · YOU\nAccept reviewed change;\ncommit + record AI use", fillcolor="#E9F7F2"];

  // Vertical spine weights keep left and right columns neatly aligned
  question -> draft_tests [style=invis, weight=20];
  draft_tests -> checkpoint [weight=20];
  checkpoint -> accept [style=invis, weight=20];

  plan -> scope [weight=20];
  scope -> repair [style=invis, weight=20];
  repair -> review [label="diff + results", weight=20];

  // Horizontal transitions within each rank
  question -> plan [constraint=false];
  scope -> draft_tests [constraint=false];
  checkpoint -> repair [label="authorise\n(tests fixed)", constraint=false];
  review -> accept [label="justified", constraint=false];

  // Outer right-margin feedback loop
  review:e -> plan:e [label=" steer / revise", constraint=false, color="#8B6D37", style=dashed];

  {rank=same; question; plan;}
  {rank=same; draft_tests; scope;}
  {rank=same; checkpoint; repair;}
  {rank=same; accept; review;}
}
