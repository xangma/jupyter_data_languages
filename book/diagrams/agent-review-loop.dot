// SPDX-License-Identifier: MIT
digraph agent_review_loop {
  graph [bgcolor="white", fontname="Arial", fontsize=18, fontcolor="#14263C",
         label="Human-controlled agent verification loop", labelloc=t,
         rankdir=TB, newrank=true, nodesep=0.34, ranksep=0.38, pad=0.14];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=15.5,
        fontcolor="#14263C", color="#BAC7D5", penwidth=1.5,
        margin="0.14,0.09"];
  edge [fontname="Arial", fontsize=13.5, fontcolor="#14263C", color="#526780",
        penwidth=1.6, arrowsize=0.8];

  question [label="1 · YOU\nTask & expectations", fillcolor="#EAF3FE"];
  plan [label="2 · AGENT\nPropose plan", fillcolor="#FFF2D6"];

  scope [label="3 · YOU\nDerive test cases", fillcolor="#EAF3FE"];
  draft_tests [label="4 · AGENT\nDraft test file", fillcolor="#FFF2D6"];

  checkpoint [label="5 · YOU\nCommit tests", fillcolor="#F0EBFA"];
  repair [label="6 · AGENT\nRepair code", fillcolor="#FFF2D6"];

  review [label="7 · YOU\nRerun & diff", fillcolor="#EAF3FE"];
  accept [label="8 · YOU\nCommit & AI_USE.md", fillcolor="#E9F7F2"];

  question -> draft_tests [style=invis, weight=20];
  draft_tests -> checkpoint [weight=20];
  checkpoint -> accept [style=invis, weight=20];

  plan -> scope [weight=20];
  scope -> repair [style=invis, weight=20];
  repair -> review [weight=20];

  question -> plan [constraint=false];
  scope -> draft_tests [constraint=false];
  checkpoint -> repair [label="authorise", constraint=false];
  review -> accept [label="verified", constraint=false];

  review:e -> plan:e [label=" steer", constraint=false, color="#8B6D37", style=dashed];

  {rank=same; question; plan;}
  {rank=same; draft_tests; scope;}
  {rank=same; checkpoint; repair;}
  {rank=same; accept; review;}
}
