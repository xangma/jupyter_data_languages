// Source: 00-primer.ipynb; slice views share memory while .copy() allocates new memory.
digraph array_views {
  graph [
    bgcolor="white", fontname="Arial", fontsize=18, fontcolor="#14263C",
    label="Slice view (shared memory) vs .copy()",
    labelloc=t, rankdir=TB, newrank=true, nodesep=0.34, ranksep=0.36, pad=0.14
  ];
  node [
    shape=plain, fontname="Arial", fontsize=15, fontcolor="#14263C",
    color="#BAC7D5", penwidth=1.4
  ];
  edge [
    fontname="Arial", fontsize=13.5, fontcolor="#14263C",
    color="#526780", penwidth=1.5, arrowsize=0.8
  ];

  start [shape=box, style="rounded,filled", fillcolor="#EAF3FE", margin="0.16,0.09",
         label=< <FONT FACE="Courier New"><B>original = [10, 20, 30, 40]</B></FONT> >];

  subgraph cluster_view {
    label="1 · Slice view";
    fontsize=16.5; style="rounded"; color="#BAC7D5"; margin=12;

    view_code [shape=box, style="rounded,filled", fillcolor="#EAF3FE", margin="0.12,0.08",
               label=< <FONT FACE="Courier New">view = original[:2]<BR/>view[0] = 99</FONT> >];

    view_mem [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#BAC7D5">
        <TR><TD COLSPAN="4" BGCOLOR="#FBEDED"><B>Shared buffer (original changed)</B></TD></TR>
        <TR>
          <TD BGCOLOR="#FBEDED"><B>99</B></TD>
          <TD BGCOLOR="#FFF2D6">20</TD>
          <TD BGCOLOR="#F3F5F7">30</TD>
          <TD BGCOLOR="#F3F5F7">40</TD>
        </TR>
      </TABLE>
    >];

    view_code -> view_mem;
  }

  subgraph cluster_copy {
    label="2 · .copy()";
    fontsize=16.5; style="rounded"; color="#BAC7D5"; margin=12;

    copy_code [shape=box, style="rounded,filled", fillcolor="#EAF3FE", margin="0.12,0.08",
               label=< <FONT FACE="Courier New">sep = original[:2].copy()<BR/>sep[0] = -5</FONT> >];

    copy_mem [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
        <TR><TD>
          <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#BAC7D5">
            <TR><TD COLSPAN="2" BGCOLOR="#F0EBFA"><B>sep (new)</B></TD></TR>
            <TR><TD BGCOLOR="#FFF2D6"><B>-5</B></TD><TD BGCOLOR="#F3F5F7">20</TD></TR>
          </TABLE>
        </TD></TR>
        <TR><TD HEIGHT="6"></TD></TR>
        <TR><TD>
          <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#BAC7D5">
            <TR><TD COLSPAN="4" BGCOLOR="#E9F7F2"><B>original (unchanged)</B></TD></TR>
            <TR>
              <TD BGCOLOR="#E9F7F2"><B>10</B></TD>
              <TD BGCOLOR="#E9F7F2"><B>20</B></TD>
              <TD BGCOLOR="#E9F7F2">30</TD>
              <TD BGCOLOR="#E9F7F2">40</TD>
            </TR>
          </TABLE>
        </TD></TR>
      </TABLE>
    >];

    copy_code -> copy_mem;
  }

  { rank=same; view_code; copy_code; }
  { rank=same; view_mem; copy_mem; }

  start -> view_code;
  start -> copy_code;
}
