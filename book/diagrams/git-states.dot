// Source: 02-git-and-tests.ipynb, Part 2 (Task A).
// Editing a file after git add leaves the second edit out of the commit.
digraph git_states {
  graph [
    bgcolor="white", fontname="Arial", fontsize=19, fontcolor="#14263C",
    label="git commit records the staged snapshot",
    labelloc=t, rankdir=TB, newrank=true, nodesep=0.42, ranksep=0.55, pad=0.16,
    splines=true
  ];
  node [
    fontname="Arial", fontsize=16, fontcolor="#14263C",
    color="#BAC7D5", penwidth=1.6, style="rounded,filled", margin="0.16,0.12"
  ];
  edge [
    fontname="Arial", fontsize=14, fontcolor="#14263C",
    color="#14263C", penwidth=1.6, arrowsize=0.82
  ];

  subgraph cluster_working {
    label="Working tree (disk)"; fontsize=17; color="#BAC7D5";
    style="rounded"; margin=14;
    w1 [shape=box, fillcolor="#EAF3FE", label=<
      <B>v1</B><BR/>
      <FONT POINT-SIZE="13" COLOR="#526780">1 test</FONT>
    >];
    w2 [shape=box, fillcolor="#FFF2D6", label=<
      <B>v2 (unstaged)</B><BR/>
      <FONT POINT-SIZE="13" COLOR="#526780">2 tests</FONT>
    >];
  }

  subgraph cluster_snapshots {
    label="Git snapshots"; fontsize=17; color="#BAC7D5";
    style="rounded"; margin=14;
    idx [shape=box, fillcolor="#E9F7F2", label=<
      <B>Index: v1</B><BR/>
      <FONT POINT-SIZE="13" COLOR="#526780">1 test</FONT>
    >];
    cmt [shape=box, fillcolor="#F0EBFA", label=<
      <B>Commit: v1</B><BR/>
      <FONT POINT-SIZE="13" COLOR="#526780">1 test only</FONT>
    >];
  }

  { rank=same; w1; idx; }
  { rank=same; w2; cmt; }

  w1 -> idx [constraint=false, label=< <B>1 · git add</B> >];
  w1 -> w2 [label=< 2 · edit file >];
  idx -> cmt [label=< <B>3 · git commit</B> >];
}
