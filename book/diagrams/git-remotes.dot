// Source: 02-git-and-tests.ipynb, Part 3 ("Remotes, clones, fetch, pull and push").
// Explains clone, fetch vs pull, push, and why non-fast-forward pushes are rejected.
digraph git_remotes {
  graph [
    bgcolor="white", fontname="Arial", fontsize=20, fontcolor="#14263C",
    label="How clone, fetch, pull and push synchronise two repositories",
    labelloc=t, rankdir=LR, newrank=true, nodesep=0.34, ranksep=0.58, pad=0.16,
    splines=true
  ];
  node [
    fontname="Arial", fontsize=15.5, fontcolor="#14263C",
    color="#BAC7D5", penwidth=1.5, style="rounded,filled", margin="0.15,0.11"
  ];
  edge [
    fontname="Arial", fontsize=14, fontcolor="#14263C",
    color="#14263C", penwidth=1.6, arrowsize=0.82
  ];

  subgraph cluster_local {
    label="Your local clone"; fontsize=18;
    style="rounded"; color="#BAC7D5"; margin=14;

    clone_note [shape=note, style="filled", fillcolor="#F0EBFA", label=<
      <B>0 · git clone &lt;url&gt;</B> (once at start)<BR/>
      <FONT POINT-SIZE="13.5">Copies full .git history, checks out<BR/>
      files, and names that remote origin</FONT>
    >];

    local_work [shape=box, fillcolor="#EAF3FE", label=<
      <B>Local branch &amp; working files</B><BR/>
      <FONT POINT-SIZE="13.5">main: C1 → C2 (plus local commit <B>L3</B>)</FONT>
    >];

    tracking [shape=box, fillcolor="#E9F7F2", label=<
      <B>Remote-tracking ref</B><BR/>
      <FONT POINT-SIZE="13.5">origin/main (or practice/main)<BR/>
      Local bookmark of remote state</FONT>
    >];

    clone_note -> local_work [style=invis, weight=10];
  }

  subgraph cluster_remote {
    label="Remote repository (origin / practice)"; fontsize=18;
    style="rounded"; color="#BAC7D5"; margin=14;

    rejected [shape=note, style="filled,dashed", fillcolor="#FBEDED", label=<
      <B>Why push can be rejected</B><BR/>
      <FONT POINT-SIZE="13.5">If remote has <B>R3</B> that your branch lacks,<BR/>
      git push stops safely (<I>non-fast-forward</I>):<BR/>
      <B>fetch → pull/merge → pytest → push</B></FONT>
    >];

    remote_branch [shape=box, fillcolor="#FFF2D6", label=<
      <B>Remote branch</B><BR/>
      <FONT POINT-SIZE="13.5">main: C1 → C2 → <B>R3</B><BR/>
      (<B>R3</B> pushed by a collaborator)</FONT>
    >];

    rejected -> remote_branch [style=dashed, arrowhead=none, color="#71849A"];
  }

  { rank=same; clone_note; local_work; tracking; }
  { rank=same; rejected; remote_branch; }

  remote_branch -> tracking [
    color="#2E7D6B", fontcolor="#2E7D6B",
    label=< <B>1 · git fetch</B><BR/><FONT POINT-SIZE="12">downloads R3; files untouched</FONT> >
  ];
  tracking -> local_work [
    color="#2E7D6B", fontcolor="#2E7D6B",
    label=< <B>2 · merge / git pull</B><BR/><FONT POINT-SIZE="12">integrates R3 into branch</FONT> >
  ];
  local_work -> remote_branch [
    label=< <B>3 · git push</B><BR/><FONT POINT-SIZE="12">uploads local commits</FONT> >
  ];
}
