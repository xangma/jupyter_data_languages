// Source: 02-git-and-tests.ipynb, Part 3 ("Remotes and clones").
// Minimal visual flow for clone, fetch, pull/merge, and push.
digraph git_remotes {
  graph [
    bgcolor="white", fontname="Arial", fontsize=19, fontcolor="#14263C",
    label="Syncing a local clone with a remote",
    labelloc=t, rankdir=LR, newrank=true, nodesep=0.45, ranksep=0.72, pad=0.16,
    splines=true
  ];
  node [
    fontname="Arial", fontsize=15.5, fontcolor="#14263C",
    color="#BAC7D5", penwidth=1.6, style="rounded,filled", margin="0.16,0.11"
  ];
  edge [
    fontname="Arial", fontsize=14, fontcolor="#14263C",
    color="#14263C", penwidth=1.6, arrowsize=0.82
  ];

  subgraph cluster_local {
    label="Local clone"; fontsize=17.5;
    style="rounded"; color="#BAC7D5"; margin=16;

    local_work [shape=box, fillcolor="#EAF3FE", label=<
      <B>Local branch</B><BR/>
      <FONT POINT-SIZE="13" COLOR="#526780">main + files</FONT>
    >];

    tracking [shape=box, fillcolor="#E9F7F2", label=<
      <B>Tracking ref</B><BR/>
      <FONT POINT-SIZE="13" COLOR="#526780">origin/main</FONT>
    >];
  }

  subgraph cluster_remote {
    label="Remote (origin)"; fontsize=17.5;
    style="rounded"; color="#BAC7D5"; margin=16;

    remote_branch [shape=box, fillcolor="#FFF2D6", label=<
      <B>Remote branch</B><BR/>
      <FONT POINT-SIZE="13" COLOR="#526780">main</FONT>
    >];
  }

  { rank=same; local_work; tracking; }

  remote_branch -> local_work [
    style=dotted, color="#526780", fontcolor="#526780",
    label=< git clone (initial copy) >
  ];
  remote_branch -> tracking [
    color="#2E7D6B", fontcolor="#2E7D6B",
    label=< <B>1 · git fetch</B> >
  ];
  tracking -> local_work [
    color="#2E7D6B", fontcolor="#2E7D6B",
    label=< <B>2 · merge / pull</B> >
  ];
  local_work -> remote_branch [
    label=< <B>3 · git push</B> >
  ];
}
