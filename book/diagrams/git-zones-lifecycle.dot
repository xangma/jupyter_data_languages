// Source: 02-git-and-tests.ipynb, Part 1.
// Visual map of the four Git zones and the commands moving snapshots between them.
digraph git_zones_lifecycle {
  graph [
    bgcolor="white", fontname="Arial", fontsize=18, fontcolor="#14263C",
    label="Git zones and commands",
    labelloc=t, rankdir=LR, nodesep=0.30, ranksep=0.38, pad=0.12,
    splines=true
  ];
  node [
    fontname="Arial", fontsize=15, fontcolor="#14263C",
    color="#BAC7D5", penwidth=1.6, style="rounded,filled", margin="0.14,0.10"
  ];
  edge [
    fontname="Arial", fontsize=13, fontcolor="#14263C",
    color="#14263C", penwidth=1.6, arrowsize=0.8
  ];

  working [shape=box, fillcolor="#EAF3FE", label=<
    <B>Working tree</B><BR/>
    <FONT POINT-SIZE="13" COLOR="#526780">saved files</FONT>
  >];

  index [shape=box, fillcolor="#E9F7F2", label=<
    <B>Staging index</B><BR/>
    <FONT POINT-SIZE="13" COLOR="#526780">next snapshot</FONT>
  >];

  local_repo [shape=box, fillcolor="#F0EBFA", label=<
    <B>Local .git</B><BR/>
    <FONT POINT-SIZE="13" COLOR="#526780">commits</FONT>
  >];

  remote [shape=box, fillcolor="#FFF2D6", label=<
    <B>Remote</B><BR/>
    <FONT POINT-SIZE="13" COLOR="#526780">origin</FONT>
  >];

  working -> index [label=< <B>git add</B> >];
  index -> local_repo [label=< <B>git commit</B> >];
  local_repo -> remote [label=< <B>git push</B> >];

  index -> working [
    style=dashed, color="#526780", fontcolor="#526780",
    label=< restore --staged >
  ];
  local_repo -> index [
    style=dashed, color="#526780", fontcolor="#526780",
    label=< reset --soft >
  ];
  remote -> local_repo [
    style=dashed, color="#2E7D6B", fontcolor="#2E7D6B",
    label=< <B>git fetch</B> >
  ];
  remote -> working [
    style=dotted, color="#2E7D6B", fontcolor="#2E7D6B",
    label=< <B>git clone / git pull</B> >
  ];
}
