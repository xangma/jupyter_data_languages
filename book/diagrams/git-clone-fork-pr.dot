// Source: 02-git-and-tests.ipynb, Part 4 ("Forks and Pull Requests").
// Minimal visual comparison of Group Repo PR vs External Fork + PR.
digraph git_clone_fork_pr {
  graph [
    bgcolor="white", fontname="Arial", fontsize=19, fontcolor="#14263C",
    label="Group repository vs Open-source Fork + Pull Request",
    labelloc=t, rankdir=LR, newrank=true, nodesep=0.28, ranksep=0.38, pad=0.14,
    splines=true
  ];
  node [
    fontname="Arial", fontsize=15, fontcolor="#14263C",
    color="#BAC7D5", penwidth=1.6, style="rounded,filled", margin="0.13,0.09"
  ];
  edge [
    fontname="Arial", fontsize=13.5, fontcolor="#14263C",
    color="#14263C", penwidth=1.6, arrowsize=0.8
  ];

  // Defined first so cluster_team renders above cluster_fork in rankdir=LR.
  subgraph cluster_fork {
    label="2 · External repo (no write access) — Fork workflow";
    fontsize=17; style="rounded"; color="#BAC7D5"; margin=14;

    upstream [shape=box, fillcolor="#FFF2D6", label=<
      <B>upstream</B><BR/>
      <FONT POINT-SIZE="12.5" COLOR="#526780">org/repo</FONT>
    >];
    fork [shape=box, fillcolor="#E9F7F2", label=<
      <B>Your Fork</B><BR/>
      <FONT POINT-SIZE="12.5" COLOR="#526780">origin (you/repo)</FONT>
    >];
    f_local [shape=box, fillcolor="#EAF3FE", label=<
      <B>Local clone</B><BR/>
      <FONT POINT-SIZE="12.5" COLOR="#526780">branch fix</FONT>
    >];
    f_pr [shape=box, fillcolor="#F0EBFA", label=<
      <B>Pull Request</B><BR/>
      <FONT POINT-SIZE="12.5" COLOR="#526780">you:fix → org:main</FONT>
    >];

    upstream -> fork [label=< <B>1 · Fork</B> >];
    fork -> f_local [label=< 2 · clone >];
    f_local -> fork [color="#2E7D6B", fontcolor="#2E7D6B", label=< 3 · push >];
    fork -> f_pr [label=< <B>4 · PR</B> >];
    upstream -> f_local [
      style=dashed, color="#526780", fontcolor="#526780",
      label=< fetch upstream >
    ];
  }

  subgraph cluster_team {
    label="1 · Group repo (write access) — Branch workflow";
    fontsize=17; style="rounded"; color="#BAC7D5"; margin=14;

    t_origin [shape=box, fillcolor="#FFF2D6", label=<
      <B>origin</B><BR/>
      <FONT POINT-SIZE="12.5" COLOR="#526780">group/repo</FONT>
    >];
    t_local [shape=box, fillcolor="#EAF3FE", label=<
      <B>Local clone</B><BR/>
      <FONT POINT-SIZE="12.5" COLOR="#526780">branch fix</FONT>
    >];
    t_pr [shape=box, fillcolor="#F0EBFA", label=<
      <B>Pull Request</B><BR/>
      <FONT POINT-SIZE="12.5" COLOR="#526780">fix → main</FONT>
    >];

    t_origin -> t_local [label=< 1 · clone >];
    t_local -> t_origin [color="#2E7D6B", fontcolor="#2E7D6B", label=< 2 · push >];
    t_origin -> t_pr [label=< <B>3 · PR</B> >];
  }
}
