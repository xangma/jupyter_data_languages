// Source: 02-git-and-tests.ipynb, Part 2 ("Merge conflict").
// Two competing edits to the same line pause at a conflict before commit M.
digraph git_branches {
  graph [
    bgcolor="white", fontname="Arial", fontsize=19, fontcolor="#14263C",
    label="Competing edits pause for conflict resolution",
    labelloc=t, rankdir=LR, nodesep=0.34, ranksep=0.50, pad=0.14,
    splines=true
  ];
  node [
    fontname="Arial", fontsize=15, fontcolor="#14263C",
    color="#BAC7D5", penwidth=1.6, style="rounded,filled", margin="0.13,0.09"
  ];
  edge [
    fontname="Arial", fontsize=13.5, fontcolor="#14263C",
    color="#14263C", penwidth=1.6, arrowsize=0.8
  ];

  base [shape=circle, fixedsize=true, width=0.56, fillcolor="#F3F5F7", label="C"];

  a [shape=box, fillcolor="#EAF3FE", label=<
    <B>A · description-a</B><BR/>
    <FONT POINT-SIZE="13" COLOR="#526780">"in degrees"</FONT>
  >];

  b [shape=box, fillcolor="#FFF2D6", label=<
    <B>B · description-b</B><BR/>
    <FONT POINT-SIZE="13" COLOR="#526780">"shortest arc"</FONT>
  >];

  conflict [shape=box, style="rounded,filled,dashed", fillcolor="#FBEDED", label=<
    <B>Conflict pause</B><BR/>
    <FONT POINT-SIZE="13" COLOR="#7A2E2E">same line edited</FONT>
  >];

  merge [shape=box, fillcolor="#E9F7F2", label=<
    <B>M · Merge commit</B><BR/>
    <FONT POINT-SIZE="13" COLOR="#2E7D6B">"degrees + shortest arc"</FONT>
  >];

  base -> a;
  base -> b;
  a -> conflict [style=dashed, color="#7A2E2E"];
  b -> conflict [style=dashed, color="#7A2E2E"];
  conflict -> merge [label=< resolve + commit >];
}
