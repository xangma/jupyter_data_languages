// Source: 00-primer.ipynb; 0-based slices and 2D axis reductions.
digraph array_axes_slicing {
  graph [
    bgcolor="white", fontname="Arial", fontsize=18, fontcolor="#14263C",
    label="1D half-open slices and 2D axis reductions",
    labelloc=t, rankdir=TB, newrank=true, nodesep=0.26, ranksep=0.36, pad=0.12
  ];
  node [
    shape=plain, fontname="Arial", fontsize=14, fontcolor="#14263C",
    color="#BAC7D5", penwidth=1.4
  ];
  edge [
    fontname="Arial", fontsize=13, fontcolor="#14263C",
    color="#526780", penwidth=1.5, arrowsize=0.8
  ];

  subgraph cluster_slicing {
    label="1 · 1D slices (stop excluded)";
    fontsize=16; style="rounded"; color="#BAC7D5"; margin=10;

    idx_table [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#BAC7D5">
        <TR>
          <TD BGCOLOR="#F3F5F7"><B>index</B></TD>
          <TD BGCOLOR="#FFFFFF">0</TD>
          <TD BGCOLOR="#FFF2D6"><B>1</B></TD>
          <TD BGCOLOR="#FFF2D6"><B>2</B></TD>
          <TD BGCOLOR="#FFF2D6"><B>3</B></TD>
          <TD BGCOLOR="#FBEDED"><B>4</B></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#EAF3FE"><B>a</B></TD>
          <TD BGCOLOR="#FFFFFF"><B>10</B></TD>
          <TD BGCOLOR="#FFF2D6"><B>20</B></TD>
          <TD BGCOLOR="#FFF2D6"><B>30</B></TD>
          <TD BGCOLOR="#FFF2D6"><B>40</B></TD>
          <TD BGCOLOR="#FFFFFF"><B>50</B></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#F3F5F7"><B>neg</B></TD>
          <TD BGCOLOR="#F0EBFA">-5</TD>
          <TD BGCOLOR="#F0EBFA">-4</TD>
          <TD BGCOLOR="#F0EBFA">-3</TD>
          <TD BGCOLOR="#F0EBFA">-2</TD>
          <TD BGCOLOR="#F0EBFA"><B>-1</B></TD>
        </TR>
      </TABLE>
    >];

    slice_rules [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#BAC7D5">
        <TR>
          <TD BGCOLOR="#F3F5F7"><FONT FACE="Courier New"><B>a[1:4]</B></FONT></TD>
          <TD BGCOLOR="#FFF2D6"><B>[20, 30, 40]</B></TD>
          <TD BGCOLOR="#FBEDED"><FONT POINT-SIZE="12">4 excluded</FONT></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#F3F5F7"><FONT FACE="Courier New"><B>a[::2]</B></FONT></TD>
          <TD BGCOLOR="#E9F7F2"><B>[10, 30, 50]</B></TD>
          <TD BGCOLOR="#E9F7F2"><FONT POINT-SIZE="12">step = 2</FONT></TD>
        </TR>
      </TABLE>
    >];

    idx_table -> slice_rules;
  }

  subgraph cluster_axes {
    label="2 · 2D grid — shape (2, 3)";
    fontsize=16; style="rounded"; color="#BAC7D5"; margin=10;

    grid_2d [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#BAC7D5">
        <TR>
          <TD BGCOLOR="#F3F5F7"></TD>
          <TD BGCOLOR="#F3F5F7"><B>col 0</B></TD>
          <TD BGCOLOR="#F3F5F7"><B>col 1</B></TD>
          <TD BGCOLOR="#F3F5F7"><B>col 2</B></TD>
          <TD BGCOLOR="#E9F7F2"><B>axis=1 →</B></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#F3F5F7"><B>row 0</B></TD>
          <TD BGCOLOR="#FFFFFF">1</TD>
          <TD BGCOLOR="#FFFFFF">2</TD>
          <TD BGCOLOR="#FFFFFF">3</TD>
          <TD BGCOLOR="#E9F7F2"><B>6</B></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#F3F5F7"><B>row 1</B></TD>
          <TD BGCOLOR="#FFFFFF">10</TD>
          <TD BGCOLOR="#FFFFFF">20</TD>
          <TD BGCOLOR="#FFFFFF">30</TD>
          <TD BGCOLOR="#E9F7F2"><B>60</B></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#F0EBFA"><B>axis=0 ↓</B></TD>
          <TD BGCOLOR="#F0EBFA"><B>11</B></TD>
          <TD BGCOLOR="#F0EBFA"><B>22</B></TD>
          <TD BGCOLOR="#F0EBFA"><B>33</B></TD>
          <TD BGCOLOR="#F3F5F7"><FONT POINT-SIZE="12">sum</FONT></TD>
        </TR>
      </TABLE>
    >];
  }

  { rank=same; idx_table; grid_2d; }
}
